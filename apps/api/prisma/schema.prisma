generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENCARGADO
}

enum PaymentMethod {
  EFECTIVO
  QR
}

enum MovementType {
  VENTA
  COMPRA
  OTRO_EGRESO
  AJUSTE
}

enum MovementDirection {
  IN
  OUT
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum ItemType {
  PRODUCTO
  SERVICIO
}

enum StockMovementType {
  COMPRA
  VENTA
  AJUSTE
}

enum SaleStatus {
  CONFIRMADA
  ANULADA
}

enum NotificationType {
  STOCK_BAJO
  CIERRE_CAJA
  CIERRE_CERRADO
  SISTEMA
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  email               String          @unique
  passwordHash        String
  role                Role            @default(ENCARGADO)
  active              Boolean         @default(true)
  mustChangePassword  Boolean         @default(false)
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  shiftTemplates      ShiftTemplate[]
  sessionsOpened      CashSession[]   @relation("CashOpenedBy")
  sessionsClosed      CashSession[]   @relation("CashClosedBy")
  sales               Sale[]
  purchases           Purchase[]
  stockMovements      StockMovement[]
  cashMovements       CashMovement[]
  stockCounts         StockCount[]
  auditLogs           AuditLog[]
  notifications       Notification[]
}

model ShiftTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int      // 1 = lunes ... 7 = domingo
  startTime String   @db.VarChar(5) // HH:mm
  endTime   String   @db.VarChar(5) // HH:mm
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, weekday, startTime, endTime])
  @@index([weekday, active])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model CashSession {
  id                String            @id @default(uuid()) @db.Uuid
  businessDate      DateTime          @db.Date @unique
  status            CashSessionStatus @default(ABIERTA)
  openingAmount     Decimal           @db.Decimal(12, 2)
  openedById        String            @db.Uuid
  openedBy          User              @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt          DateTime          @default(now())
  closedById        String?           @db.Uuid
  closedBy          User?             @relation("CashClosedBy", fields: [closedById], references: [id])
  closedAt          DateTime?
  expectedCash      Decimal?          @db.Decimal(12, 2)
  countedCash       Decimal?          @db.Decimal(12, 2)
  diffCash          Decimal?          @db.Decimal(12, 2)
  expectedQr        Decimal?          @db.Decimal(12, 2)
  countedQr         Decimal?          @db.Decimal(12, 2)
  diffQr            Decimal?          @db.Decimal(12, 2)
  qrCountedManually Boolean           @default(false)
  note              String?
  expectedAt        DateTime?
  closeNotifiedAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  movements         CashMovement[]
  sales             Sale[]
  purchases         Purchase[]
}

model CashMovement {
  id          String            @id @default(uuid()) @db.Uuid
  sessionId   String            @db.Uuid
  session     CashSession       @relation(fields: [sessionId], references: [id])
  type        MovementType
  direction   MovementDirection
  method      PaymentMethod
  amount      Decimal           @db.Decimal(12, 2)
  description String
  saleId      String?           @db.Uuid
  sale        Sale?             @relation(fields: [saleId], references: [id])
  purchaseId  String?           @db.Uuid
  purchase    Purchase?         @relation(fields: [purchaseId], references: [id])
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@index([saleId])
  @@index([purchaseId])
}

model Item {
  id          String          @id @default(uuid()) @db.Uuid
  type        ItemType
  sku         String?         @unique
  name        String
  category    String?
  salePrice   Decimal         @db.Decimal(12, 2)
  lastCost    Decimal?        @db.Decimal(12, 2)
  stock       Decimal?        @db.Decimal(12, 3)
  minStock    Decimal?        @db.Decimal(12, 3)
  reorderQty  Decimal?        @db.Decimal(12, 3)
  unit        String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  stockMovements    StockMovement[]
  alertNotifications AlertNotification[]
  stockCountLines   StockCountLine[]
}

model Sale {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique
  sessionId       String      @db.Uuid
  session         CashSession @relation(fields: [sessionId], references: [id])
  createdById     String      @db.Uuid
  createdBy       User        @relation(fields: [createdById], references: [id])
  soldAt          DateTime    @default(now())
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  method          PaymentMethod
  status          SaleStatus  @default(CONFIRMADA)
  cancelledById   String?
  cancelledAt     DateTime?
  cancellationNote String?

  items           SaleItem[]
  movements       CashMovement[]
  stockMovements  StockMovement[]

  @@index([sessionId, soldAt])
  @@index([createdById])
}

model SaleItem {
  id         String  @id @default(uuid()) @db.Uuid
  saleId     String  @db.Uuid
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId     String  @db.Uuid
  item       Item    @relation(fields: [itemId], references: [id])
  nameSnapshot String
  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Decimal @db.Decimal(12, 3)
  subtotal   Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([itemId])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  purchases Purchase[]
}

model Purchase {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String?   @db.Uuid
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierName String
  sessionId   String    @db.Uuid
  session     CashSession @relation(fields: [sessionId], references: [id])
  createdById String    @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  purchasedAt DateTime  @default(now())
  total       Decimal   @db.Decimal(12, 2)
  method      PaymentMethod @default(EFECTIVO)
  note        String?
  items       PurchaseItem[]
  movements   CashMovement[]
  stockMovements StockMovement[]

  @@index([sessionId, purchasedAt])
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @db.Uuid
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String  @db.Uuid
  item       Item    @relation(fields: [itemId], references: [id])
  nameSnapshot String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([itemId])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  itemId      String            @db.Uuid
  item        Item              @relation(fields: [itemId], references: [id])
  type        StockMovementType
  delta       Decimal           @db.Decimal(12, 3)
  note        String?
  saleId      String?           @db.Uuid
  sale        Sale?             @relation(fields: [saleId], references: [id])
  purchaseId  String?           @db.Uuid
  purchase    Purchase?         @relation(fields: [purchaseId], references: [id])
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([itemId, createdAt])
}

model StockCount {
  id          String @id @default(uuid()) @db.Uuid
  businessDate DateTime @db.Date
  countedById String @db.Uuid
  countedBy   User @relation(fields: [countedById], references: [id])
  countedAt   DateTime @default(now())
  note        String?
  lines       StockCountLine[]
}

model StockCountLine {
  id            String     @id @default(uuid()) @db.Uuid
  countId       String     @db.Uuid
  count         StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId        String     @db.Uuid
  item          Item       @relation(fields: [itemId], references: [id])
  expectedStock Decimal    @db.Decimal(12, 3)
  actualStock   Decimal    @db.Decimal(12, 3)
  diff          Decimal    @db.Decimal(12, 3)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  sequence  BigInt   @unique @default(autoincrement())
  prevHash  String
  hash      String
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  actorRole String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model AlertNotification {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @db.Uuid
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind       String
  recipient  String
  sentAt     DateTime @default(now())

  @@index([itemId, kind, sentAt])
}

model EmailOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  toAddress     String
  subject       String
  body          String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}
